# Puzzle inputs — AoC asks that these are not republished
/days/*/input.txt

# Per-solution bench output (aggregated into benchmarks.json / benchmarks.md)
# bench.md: pre-v3 solutions; bench.json: lang-templates v3+
/days/*/bench.md
/days/*/bench.json

# Build artifacts
/days/**/target/
/days/**/node_modules/
/days/**/.venv/
/days/**/__pycache__/
/days/**/*.pyc
/days/**/.pytest_cache/
/days/*/solution

# .NET / Zig build artifacts
/days/**/bin/
/days/**/obj/
/days/**/out/
/days/**/TestResults/
/days/**/.zig-cache/
/days/**/zig-out/

# macOS
.DS_Store
